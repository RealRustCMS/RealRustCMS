# ─── BANCO DE DADOS ──────────────────────────────────────
# (obrigatório)
DATABASE_URL=postgres://usuario:senha@localhost/rustcms

# Teto de conexões do pool (opcional)
# Padrão 20. Cada page-view usa 3-8 queries + a sessão; o default interno do
# SQLx é 10, baixo demais sob carga. Não passe de ~25-30 por instância sem
# PgBouncer.
DB_MAX_CONEXOES=20

# ─── IDENTIDADE DO SITE ──────────────────────────────────
# (obrigatório)
SITE_NOME=Meu Site
SITE_DESCRICAO=Descrição do meu site

# Caminho do logo exibido no painel (opcional)
# Deixe vazio para usar as iniciais do SITE_NOME
SITE_LOGO=

# ─── SERVIDOR ────────────────────────────────────────────
# Porta local (padrão: 3000)
# Em plataformas como Railway a variável PORT é injetada automaticamente
PORTA=3000

# URL base do site — usada para montar redirect_uri nos fluxos OIDC
# Desenvolvimento: http://localhost:3000
# Produção:        https://meusite.com  (sem barra no final)
BASE_URL=http://localhost:3000

# ─── SESSÕES ─────────────────────────────────────────────
# Chave de assinatura dos cookies de sessão (obrigatório)
# Mínimo 64 caracteres — NUNCA use o valor de exemplo abaixo em produção
#
# Gere um valor seguro com um dos comandos abaixo:
#   Linux/Mac:  openssl rand -base64 64
#   PowerShell: -join ((1..64) | ForEach-Object { [char](Get-Random -Min 33 -Max 126) })
#
SESSION_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_NO_MINIMO_64_CARACTERES_AQUI

# ─── PAGINAÇÃO ───────────────────────────────────────────
ARTIGOS_POR_PAGINA=10
ARTIGOS_RELACIONADOS=3                  # quantidade de artigos relacionados exibidos no rodapé do artigo
ARTIGOS_DESTAQUE=4                      # máximo de artigos em destaque na home (1 hero + N-1 secundários)
VIEWS_NO_DASHBOARD=5

# ─── UPLOADS ─────────────────────────────────────────────
# Tamanho máximo de upload em MB (padrão: 10)
UPLOAD_TAMANHO_MAXIMO_MB=10

# ─── APARÊNCIA ───────────────────────────────────────────
# Tema de cor do painel administrativo (padrão: verde)
# Opções: verde, cinza, azul, dourado, roxo, escuro
TEMA=verde

# Template da área pública (padrão: vazio = default)
# Opções: default, deco (recomendado — padrão atual do RustCMS)
# Para criar um tema novo: adicione uma pasta em templates/publico/
TEMPLATE_PUBLICO=deco

# ─── LOGS ────────────────────────────────────────────────
# Nível de log da aplicação
# Desenvolvimento: rustcms=debug,sqlx=warn
# Produção:        rustcms=info,sqlx=warn
RUST_LOG=rustcms=info,sqlx=warn

# ─── AMBIENTE ────────────────────────────────────────────
# false (padrão): desenvolvimento local sem HTTPS
# true: produção — ativa Secure flag no cookie de sessão
# Em Railway/Render/Fly.io: configure PRODUCAO=true no painel da plataforma
PRODUCAO=false

# ─── MFA ─────────────────────────────────────────────────
# Autenticação em dois fatores via TOTP (Google Authenticator, Microsoft Authenticator, Authy)
# false (padrão): MFA opcional — cada usuário decide se ativa no próprio perfil
# true: MFA obrigatório para todos — ninguém entra no painel sem configurar
# O admin também pode exigir MFA individualmente por usuário na tela de edição
MFA_OBRIGATORIO=false

# ─── E-MAIL / NOTIFICAÇÕES (opcional) ───────────────────
# SMTP para notificações de comentários
# Deixe SMTP_HOST vazio para desabilitar o envio de e-mails
SMTP_HOST=                          # ex: smtp.gmail.com
SMTP_PORT=587                       # 587 (STARTTLS) ou 465 (SSL)
SMTP_USUARIO=                       # e-mail remetente
SMTP_SENHA=                         # senha ou app password
NOTIF_PADRAO=false                  # valor padrão de notificar_comentarios ao criar artigo

# ─── CAPTCHA (opcional) ──────────────────────────────────
# Cloudflare Turnstile para proteção dos comentários
# Deixe vazio para desabilitar o captcha
# Obtenha as chaves em: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── CSP — fontes extras (opcional) ──────────────────────
# O RustCMS já inclui as fontes necessárias para seu funcionamento padrão
# (Google Fonts, Cloudflare Turnstile). Use estas variáveis para adicionar
# origens externas ao seu template sem precisar recompilar o projeto.
#
# Múltiplas origens na mesma diretiva: separe por espaço.
#   CSP_EXTRA_SCRIPT_SRC=https://www.googletagmanager.com https://analytics.com
#
# Exemplos de uso:
#   Google Analytics / Tag Manager: CSP_EXTRA_SCRIPT_SRC=https://www.googletagmanager.com
#   Fontes externas adicionais:     CSP_EXTRA_STYLE_SRC=https://cdn.jsdelivr.net
#   Imagens de CDN externo:         CSP_EXTRA_IMG_SRC=https://images.unsplash.com
#   APIs externas via fetch/XHR:    CSP_EXTRA_CONNECT_SRC=https://api.exemplo.com
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_STYLE_SRC=
CSP_EXTRA_IMG_SRC=
CSP_EXTRA_CONNECT_SRC=

# ─── ÁREA DE MEMBROS (opcional) ──────────────────────────
# Controla quem pode acessar a área restrita de membros em /membros/area
#
# Comportamento padrão (ambos vazios/false):
#   Apenas membros cadastrados manualmente pelo admin em /admin/membros
#
# MEMBROS_PERMITIR_CADASTRO=true:
#   Qualquer visitante pode se cadastrar em /membros/cadastro
#   Qualquer conta SSO configurada vira membro automaticamente no primeiro login
#
# MEMBROS_DOMINIO_PERMITIDO=suaempresa.com.br:
#   Apenas e-mails desse domínio viram membros automaticamente via SSO
#   Tem precedência sobre MEMBROS_PERMITIR_CADASTRO
#   Ideal para intranets e portais corporativos (ex: só @empresa.com.br entra)
#
# Exemplos:
#   Portal corporativo (só funcionários via SSO):
#     MEMBROS_DOMINIO_PERMITIDO=suaempresa.com.br
#
#   Comunidade aberta (qualquer um pode se cadastrar):
#     MEMBROS_PERMITIR_CADASTRO=true
#
#   Acesso controlado (só quem o admin cadastrar):
#     MEMBROS_PERMITIR_CADASTRO=false
#     MEMBROS_DOMINIO_PERMITIDO=
#
MEMBROS_PERMITIR_CADASTRO=false
MEMBROS_DOMINIO_PERMITIDO=

# ─── OIDC — Google (opcional) ────────────────────────────
# Deixe vazio para desabilitar o botão "Entrar com Google"
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OIDC — Microsoft (opcional) ─────────────────────────
# Deixe vazio para desabilitar o botão "Entrar com Microsoft"
# Obtenha as credenciais em: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Authorized redirect URI: {BASE_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Opções: common (qualquer conta), organizations (só corporativas), ou UUID do tenant
MICROSOFT_TENANT_ID=common

# ─── OIDC — GitHub (opcional) ────────────────────────────
# Deixe vazio para desabilitar o botão "Entrar com GitHub"
# Crie um OAuth App em: https://github.com/settings/developers
# Authorization callback URL: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OIDC — Provedor genérico (opcional) ─────────────────
# Para Keycloak, RHSSO, Authentik, Dex ou qualquer provedor OIDC compatível
# Deixe OIDC_CLIENT_ID vazio para desabilitar
# Redirect URI a registrar no provedor: {BASE_URL}/auth/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# URL do discovery document do provedor:
# Keycloak: https://sso.empresa.com/realms/minha-org/.well-known/openid-configuration
# RHSSO:    https://sso.empresa.com/auth/realms/minha-org/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
# Texto exibido no botão de login (ex: "Entrar com SSO Corporativo")
OIDC_BOTAO_LABEL=

# ─── OIDC — Controle de cadastro automático ──────────────
# false (padrão): só entra quem o admin já cadastrou previamente
#   → admin cria o usuário com nome, e-mail e papel
#   → na primeira autenticação OIDC o sistema vincula automaticamente pelo e-mail
# true: cria usuário novo automaticamente com papel "visualizador"
#   → qualquer pessoa com conta no provedor consegue entrar
#
# OIDC_PERMITIR_CADASTRO aplica-se a Google, Microsoft e GitHub
# OIDC_GENERICO_PERMITIR_CADASTRO aplica-se ao provedor genérico (Keycloak etc.)
# Separá-los permite políticas diferentes por provedor
OIDC_PERMITIR_CADASTRO=false
OIDC_GENERICO_PERMITIR_CADASTRO=false
